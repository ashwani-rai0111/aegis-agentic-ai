# Copy to .env and fill in values
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# Required for real CrewAI LLM decisions. If missing, Aegis uses deterministic agent mode.
OPENAI_API_KEY=

# auto | crewai | deterministic
# auto = CrewAI when OPENAI_API_KEY is set, otherwise deterministic mock-agent loop
AEGIS_AGENT_MODE=auto

# OpenAI model used by CrewAI
OPENAI_MODEL_NAME=gpt-4o-mini

AEGIS_VERBOSE=true

# Tool backend: mock (local demos) | aws (live EC2/CloudWatch/SSM)
AEGIS_TOOL_BACKEND=mock

# --- AWS (required when AEGIS_TOOL_BACKEND=aws or using POST /incidents/live) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AEGIS_EC2_INSTANCE_ID=i-xxxxxxxx
AEGIS_CW_ALARM_NAME=prod-api-high-latency
AEGIS_HEALTHCHECK_URL=https://signyn.com
AEGIS_SSM_DOCUMENT=AWS-RunShellScript
AEGIS_CW_NAMESPACE=CWAgent
AEGIS_PM2_BIN=pm2
# Linux user that owns PM2 (leave empty to auto-detect the user with apps)
# On Signyn EC2 this is typically root (PM2_HOME=/root/.pm2)
AEGIS_PM2_USER=root
# PM2 process names allowed for low-risk restart (comma-separated)
AEGIS_PM2_ALLOWLIST=signyn,signyardsnext,node-server,websites,api,worker

# Live MySQL (SSM on the EC2 host). Leave user/password empty for socket/root auth.
AEGIS_MYSQL_ENABLED=true
AEGIS_MYSQL_HOST=127.0.0.1
AEGIS_MYSQL_PORT=3306
AEGIS_MYSQL_USER=
AEGIS_MYSQL_PASSWORD=
AEGIS_MYSQL_PROD_DATABASE=signyards
AEGIS_MYSQL_STAGING_DATABASE=uatsignyards
AEGIS_MYSQL_SERVICE_NAME=mysql
AEGIS_MYSQL_CONN_SATURATION_PCT=90
AEGIS_MYSQL_THREADS_RUNNING_WARN=50
# Medium-risk: only runs after dashboard Approve
AEGIS_MYSQL_RESTART_ENABLED=true
